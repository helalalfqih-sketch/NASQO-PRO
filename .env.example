# NASQO PRO ERP — Server Environment Configuration Example
# Copy to .env and populate in your deployment environment (never commit real secrets).

PORT=3000
NODE_ENV=development

# --- Local SQLite Access Protection (Required for remote/production access) ---
NASQO_SQLITE_DB_PATH=data/nasqo.sqlite
NASQO_SQLITE_ADMIN_PASSWORD=
NASQO_SQLITE_SESSION_SECRET=

# --- Google Vertex AI / Gemini (@google/genai server-side integration) ---
# Set GOOGLE_GENAI_USE_VERTEXAI=true to route requests through Google Cloud Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=gen-lang-client-0457000612
GOOGLE_CLOUD_LOCATION=europe-west3
# Optional: Vertex AI Express Mode API key or service account JSON path (ADC)
VERTEX_AI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Standard Gemini API key (used automatically when Vertex AI is not enabled)
GEMINI_API_KEY=
# Optional model override (must be an active Gemini model such as gemini-4-hydrogen)
VERTEX_AI_MODEL=gemini-4-hydrogen
